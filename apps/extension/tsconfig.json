{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    // `.ts` extensions are opt-in per import. Regular source imports omit
    // them (convention); Node-runnable self-check scripts like
    // `ulid.check.ts` need them since Node's --experimental-strip-types
    // loader requires the real filename.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // JSX with Preact's automatic runtime — matches what @preact/preset-vite
    // configures at bundle time.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["firefox-webext-browser", "node"]
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "web-ext-artifacts"]
}
