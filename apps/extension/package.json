{
  "name": "@focus-tracker/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Focus Tracker browser extension (Firefox-only, MV3 event page). See Sources Markdown/Extension.md.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "icons": "node scripts/build-icons.mjs",
    "webext:lint": "web-ext lint --source-dir=dist",
    "webext:build": "web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts --overwrite-dest --filename=focus-tracker-{version}.xpi",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@focus-tracker/shared": "workspace:*"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/firefox-webext-browser": "^120.0.4",
    "preact": "^10.29.8",
    "sharp": "^0.33.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0",
    "web-ext": "^8.3.0"
  }
}
