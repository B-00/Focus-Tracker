{
  "manifest_version": 3,
  "name": "Focus Tracker",
  "short_name": "Focus Tracker",
  "version": "0.0.1",
  "description": "Captures website focus events and ships them to the Focus Tracker API.",
  "author": "Focus Tracker",
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-tracker@local.dev",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*"
  ]
}
