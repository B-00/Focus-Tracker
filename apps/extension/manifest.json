{
  "manifest_version": 3,
  "name": "Focus Tracker",
  "short_name": "Focus Tracker",
  "version": "0.0.1",
  "description": "Captures website focus events and ships them to the Focus Tracker API.",
  "author": "Focus Tracker",
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-tracker@local.dev",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Focus Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*"
  ]
}
